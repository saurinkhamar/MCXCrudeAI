# Local Upstox OAuth/market-data credentials. Keep actual values only in backend/.env.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
UPSTOX_INSTRUMENT_KEY=MCX_FO|576265
CANDLE_INTERVAL_MINUTES=5
# Optional Gemini API credentials. AGENT_MODE=auto uses ADK only when this is set.
GOOGLE_API_KEY=
GOOGLE_MODEL=Gemini 3.5 Flash-Lite
AGENT_MODE=auto
AGENT_OUTPUT_TOKENS=700
# Official EIA RSS feeds used by the live fundamental analyst; comma-separated.
FUNDAMENTAL_FEED_URLS=https://www.eia.gov/rss/todayinenergy.xml,https://www.eia.gov/rss/press_rss.xml
FUNDAMENTAL_REFRESH_MINUTES=60
FUNDAMENTAL_MAX_ITEMS=12
MAX_STOP_POINTS=100
RISK_PER_TRADE_INR=2000
MAX_DAILY_LOSS_INR=5000
CONTRACT_MULTIPLIER=10
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=5
BROKERAGE_RATE=0.0003
TRANSACTION_TAX_RATE=0.0002
FIXED_TRANSACTION_CHARGES_INR=40
